{
  "name": "@es-ts-example/workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-beta.84",
      "effect": "4.0.0-beta.84",
      "effect-bdd": "0.5.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run build:packages && bun run build:tools",
    "build:packages": "bun run --parallel --filter '*' build",
    "build:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "bun run check:without-mutation && bun run mutation",
    "check:without-mutation": "bun run build && bun run lint && bun run format:check && bun run test && bun run test:property && bun run e2e",
    "ci": "bun run check",
    "dry:report": "jscpd --config .jscpd.json || true",
    "format": "bun run format:write",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint": "bun run lint:policy && bun run lint:oxlint && bun run lint:coverage-policy && bun run lint:package-boundaries && bun run lint:knip",
    "lint:policy": "bun run lint:suppression-policy && bun run lint:repo-path-policy && bun run lint:noop-scripts && bun run lint:policy-exception-health && bun run lint:mutation-scope && bun run lint:stryker-config && bun run lint:unit-test-architecture && bun run lint:bdd-step-duplication && bun run lint:bdd-support-architecture && bun run lint:web-ui-components && bun run lint:web-css-tokens && bun run lint:i18n-messages && bun run lint:literal-unions && bun run lint:custom-rule-tests",
    "lint:bdd-step-duplication": "bun run scripts/lint-bdd-step-duplication.ts",
    "lint:bdd-support-architecture": "bun run scripts/lint-bdd-support-architecture.ts",
    "lint:custom-rule-tests": "bun run scripts/lint-custom-rule-tests.ts",
    "lint:coverage-policy": "bun run scripts/lint-coverage-policy.ts",
    "lint:package-boundaries": "depcruise --config .dependency-cruiser.js --output-type err packages scripts",
    "lint:i18n-messages": "bun run scripts/lint-i18n-messages.ts",
    "lint:knip": "knip",
    "lint:literal-unions": "bun run scripts/lint-literal-unions.ts",
    "lint:mutation-baselines": "bun run scripts/lint-mutation-baselines.ts",
    "lint:mutation-report-health": "bun run scripts/lint-mutation-report-health.ts",
    "lint:oxlint": "oxlint .",
    "lint:mutation-scope": "bun run scripts/lint-mutation-scope.ts",
    "lint:noop-scripts": "bun run scripts/lint-noop-scripts.ts",
    "lint:policy-exception-health": "bun run scripts/lint-policy-exception-health.ts",
    "lint:repo-path-policy": "bun run scripts/lint-repo-path-policy.ts",
    "lint:stryker-config": "bun run scripts/lint-stryker-config.ts",
    "lint:suppression-policy": "bun run scripts/lint-suppression-policy.ts",
    "lint:unit-test-architecture": "bun run scripts/lint-unit-test-architecture.ts",
    "lint:web-ui-components": "bun run scripts/lint-web-ui-components.ts",
    "lint:web-css-tokens": "bun run scripts/lint-web-css-tokens.ts",
    "test": "bun run test:unit",
    "test:coverage": "bun run test:unit",
    "test:packages": "bun run --parallel --filter '*' test",
    "test:property": "bun run test:property:packages",
    "test:property:packages": "bun run --parallel --filter '*' test:property",
    "test:unit": "bun run test:packages",
    "e2e": "bun run e2e:packages",
    "e2e:application": "bun --filter @es-ts-example/application e2e",
    "e2e:domain": "bun --filter @es-ts-example/domain e2e",
    "e2e:event-sourcing": "bun --filter @es-ts-example/event-sourcing e2e",
    "e2e:packages": "bun run --filter '*' e2e",
    "acceptance": "bun run e2e",
    "acceptance:domain": "bun run e2e:domain",
    "acceptance:event-sourcing": "bun run e2e:event-sourcing",
    "acceptance:packages": "bun run e2e:packages",
    "mutation": "bun run mutation:packages",
    "mutation:dev": "MUTATION_PACKAGE_SCRIPT=mutation:dev bun run scripts/mutation-timed.ts",
    "mutation:packages": "bun run scripts/mutation-timed.ts",
    "mutation:timed": "bun run scripts/mutation-timed.ts",
    "prepare": "husky",
    "precommit": "bun run check",
    "start": "bun run start:web",
    "start:web": "PORT=${WEB_PORT:-${PORT:-3000}} STORAGE_BACKEND=${STORAGE_BACKEND:-json-file} EVENT_STORE_FILE=${EVENT_STORE_FILE:-$PWD/.counter-events.json} bun --filter @es-ts-example/web start",
    "start:cli": "EVENT_STORE_FILE=${EVENT_STORE_FILE:-$PWD/.counter-events.json} bun --filter @es-ts-example/cli start"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@hughescr/stryker-bun-runner": "^1.2.2",
    "@oxlint/plugins": "^1.70.0",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "latest",
    "dependency-cruiser": "^17.4.3",
    "effect": "catalog:",
    "effect-bdd": "catalog:",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "knip": "^6.17.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
