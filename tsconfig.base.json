{
  "$schema": "http://json.schemastore.org/tsconfig",
  "include": [],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "types": ["bun"],
    "paths": {
      "@es-ts-example/application": ["./packages/application/src/index.ts"],
      "@es-ts-example/cli": ["./packages/cli/src/index.ts"],
      "@es-ts-example/domain": ["./packages/domain/src/index.ts"],
      "@es-ts-example/event-sourcing": ["./packages/event-sourcing/src/index.ts"],
      "@es-ts-example/web": ["./packages/web/src/index.ts"],
      "@es-ts-example/test-support/*": ["./packages/test-support/src/*.ts"]
    }
  }
}
